{
  "protocol": "FGCS_OVERHEAD_ROUND2_V2",
  "measurementSchema": "FGCS_OVERHEAD_MEASUREMENT_V2",
  "outputRoot": "paper/tmp/fgcs-round2/overhead",
  "workflows": [
    "datasets/dax/montage/n50/Montage_50.dax",
    "datasets/dax/montage/n1000/Montage_1000.dax",
    "experiments/studies/makespan-scale/inputs/Montage_5000.dax"
  ],
  "measuredRepetitions": 5,
  "measuredRuns": 45,
  "warmupPerFreshJvm": 1,
  "warmupRowsReported": 0,
  "freshJvmPerMeasuredRun": true,
  "officialEntryPoint": "scripts/run-fgcs-matrix.py --overhead-only --repetitions 5 --output paper/tmp/fgcs-round2",
  "functionalInProcessProtocol": "FGCS_OVERHEAD_FUNCTIONAL_V2 is test-only and rejected by the round-two verifier",
  "serialSimulations": true,
  "modeOrder": {
    "rule": "rotate [off, events, lifecycle] left by (workflowIndex + repetition) mod 3",
    "recordedFields": ["workflowIndex", "repetition", "modeOrder", "modeOrderIndex"],
    "globalPositionCountsPerModeAtFiveRepetitions": [5, 5, 5]
  },
  "commonConfiguration": {
    "inputPopulation": "UNIQUE_PRODUCER_FILE_IDENTITY_V1 normalized input at the same measured-root path",
    "dataMovementModel": "COHERENT_STORAGE_DATAFLOW_V3",
    "planningAlgorithm": "RANDOM",
    "schedulingAlgorithm": "STATIC",
    "fileSystem": "LOCAL",
    "randomSeed": 7,
    "vmCount": 4,
    "platformProfile": "FGC_STORAGE_4_VMS_1_HOST",
    "eventRecorderCap": 200000
  },
  "modes": {
    "off": {
      "eventRecordingEnabled": false,
      "networkEvidenceMode": "OFF",
      "eventCount": 0,
      "eventStreamBytes": 0,
      "bundle": "manifest + metrics + empty events",
      "pythonValidationStatus": "DISABLED"
    },
    "events": {
      "eventRecordingEnabled": true,
      "networkEvidenceMode": "OFF",
      "eventCount": "positive",
      "eventStreamBytes": "positive",
      "bundle": "manifest + metrics + nonempty events; no lifecycle sidecar",
      "pythonValidationNanos": null,
      "pythonValidationStatus": "NA",
      "pythonValidationScope": "NOT_APPLICABLE_EVENT_ONLY_BUNDLE_WITHOUT_LIFECYCLE_CAPTURE"
    },
    "lifecycle": {
      "eventRecordingEnabled": true,
      "networkEvidenceMode": "FILE_STORAGE_LIFECYCLE_V3",
      "eventCount": "positive",
      "eventStreamBytes": "positive",
      "bundle": "manifest + metrics + nonempty events + storage-lifecycle V3 sidecar",
      "pythonValidationStatus": "VALID_COMPLETE"
    }
  },
  "timingFields": {
    "simulationNanos": "SimulationRunner only",
    "serializationAndSizeAccountingNanos": "common bundle serialization plus artifact size reads; artifactWriteNanos is a compatibility alias",
    "auditNanos": "in-memory AlgorithmMetricAudit only",
    "javaValidationNanos": "ExperimentArtifactValidator over the serialized bundle",
    "pythonValidationNanos": "python3 process startup plus verify-network-ledger.py over the serialized bundle; null for event-only bundles"
  },
  "sizeFields": ["artifactBytes", "manifestBytes", "metricsBytes", "eventStreamBytes", "lifecycleEvidenceBytes"],
  "memoryFields": {
    "sampledTotalHeapPeakBytes": "maximum MemoryMXBean heap-used sample across simulation, serialization and in-memory audit; sampled approximation, not a true peak or minimum-memory requirement",
    "heapSampleCount": "number of total-heap samples",
    "heapSampleRequestedIntervalNanos": 1000000,
    "heapPoolPeakSumBytes": "diagnostic sum of independent heap-pool peaks; not simultaneous and not minimum memory",
    "heapBeforeBytes": "pre-run heap-used sample",
    "threadAllocatedBytes": "current-thread cumulative allocation delta or null when unsupported"
  },
  "eventDependentMetrics": {
    "fields": ["meanWaitingSeconds", "meanTrueSlowdown"],
    "availabilityFields": ["meanWaitingSecondsAvailable", "meanTrueSlowdownAvailable", "eventDependentMetricAvailability"],
    "observationCountFields": ["totalWaitingTimeObservationCount", "trueSlowdownObservationCount"],
    "offValue": null,
    "reason": "JobOutcome.submissionTime is VM submission, not dependency-ready time; disabled event recording cannot reconstruct these observations"
  },
  "statistics": {
    "rawPerTrialValues": "overhead/results.json and trials in overhead-summary.json",
    "distributionFields": ["Median", "Min", "Max", "Range", "Q1", "Q3", "IQR"],
    "quartileMethod": "statistics.quantiles(method=inclusive); singleton Q1=Q3=value",
    "pairedComparisons": ["EVENTS_MINUS_OFF", "LIFECYCLE_MINUS_OFF", "LIFECYCLE_MINUS_EVENTS"],
    "pairedRawAndSummary": "overhead-paired-deltas.json and overhead-paired-deltas.csv",
    "naPolicy": "all-NA groups emit null statistics; mixed numeric/NA groups and missing fields fail"
  },
  "outputs": [
    "results.json",
    "runs/<scenario>.json",
    "parts/<workflow>-<mode>.json",
    "evidence/measured/artifacts/<scenario>/result.manifest.json",
    "evidence/measured/artifacts/<scenario>/result.metrics.json",
    "evidence/measured/artifacts/<scenario>/result.events.jsonl",
    "matrix-summary.json (overhead-only summarizer)",
    "overhead-summary.json",
    "overhead-summary.csv",
    "overhead-paired-deltas.json",
    "overhead-paired-deltas.csv"
  ]
}
