<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.workflowsim</groupId>
        <artifactId>workflowsim-parent</artifactId>
        <version>1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>workflowsim-workbench</artifactId>
    <packaging>jar</packaging>
    <name>WfLedger Workbench</name>
    <description>Workbench unified experiment entry point, research drivers, reproduction tooling, frozen reference baselines, and teaching examples.</description>

    <properties>

        <workflowsim.jacoco.instruction.minimum>0.59</workflowsim.jacoco.instruction.minimum>
        <workflowsim.jacoco.branch.minimum>0.55</workflowsim.jacoco.branch.minimum>
        <workflowsim.jacoco.package.instruction.minimum>0.71</workflowsim.jacoco.package.instruction.minimum>
        <workflowsim.jacoco.package.branch.minimum>0.53</workflowsim.jacoco.package.branch.minimum>
        <workflowsim.jacoco.it.instruction.minimum>0.50</workflowsim.jacoco.it.instruction.minimum>
        <workflowsim.jacoco.it.branch.minimum>0.44</workflowsim.jacoco.it.branch.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.workflowsim</groupId>
            <artifactId>workflowsim</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <workflowsim.datasetRoot>${project.parent.basedir}/datasets</workflowsim.datasetRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <workflowsim.datasetRoot>${project.parent.basedir}/datasets</workflowsim.datasetRoot>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId></plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>${workflowsim.experiments.exec.skip}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
