<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.workflowsim</groupId>
    <artifactId>workflowsim-parent</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <name>WfLedger</name>
    <description>WfLedger: a discrete-event simulator for scientific workflow scheduling research.</description>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>simulator</module>
        <module>experiments</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.minimum.version>3.6.3</maven.minimum.version>
        <maven.build.java.version>17</maven.build.java.version>
        <maven.compiler.release>8</maven.compiler.release>
        <workflowsim.javadoc.skip>true</workflowsim.javadoc.skip>
        <workflowsim.simulator.exec.skip>true</workflowsim.simulator.exec.skip>
        <workflowsim.experiments.exec.skip>false</workflowsim.experiments.exec.skip>

        <argLine></argLine>

        <surefire.excludes>**/*IntegrationTest.java,**/*ExtendedCorpusTest.java</surefire.excludes>

        <workflowsim.jacoco.instruction.minimum>0.00</workflowsim.jacoco.instruction.minimum>
        <workflowsim.jacoco.branch.minimum>0.00</workflowsim.jacoco.branch.minimum>

        <workflowsim.jacoco.package.instruction.minimum>0.00</workflowsim.jacoco.package.instruction.minimum>
        <workflowsim.jacoco.package.branch.minimum>0.00</workflowsim.jacoco.package.branch.minimum>
        <workflowsim.jacoco.it.instruction.minimum>0.00</workflowsim.jacoco.it.instruction.minimum>
        <workflowsim.jacoco.it.branch.minimum>0.00</workflowsim.jacoco.it.branch.minimum>
    </properties>

    <build>
        <plugins>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Code-regularization Phase 2: the tiered checkstyle gate.
                 Rule ledger and tier definitions: config/checkstyle/checkstyle.xml
                 (Tier-A errors are zero-tolerance, Tier-B warnings stay on record).
                 Only severity=error violations fail the build (violationSeverity=error);
                 the advisory-rule backlog is tracked by the baseline report and is promoted to
                 error once it reaches zero (rules only grow; see the configuration file header).
                 Red line: upstream org.cloudbus* code leaves the gate entirely in the
                 configuration; test volume/complexity exemptions are in suppressions.xml. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>checkstyle-tier-gate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotless-format-gate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <excludes>${surefire.excludes}</excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.2.5</version>
                    <executions>
                        <execution>
                            <id>run-integration-tests</id>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <includes>
                            <include>**/*IntegrationTest.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                    <executions>
                        <execution>
                            <id>enforce-build-toolchain</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <version>[${maven.minimum.version},)</version>
                                        <message>WorkflowSim requires Maven ${maven.minimum.version} or newer.</message>
                                    </requireMavenVersion>
                                    <requireJavaVersion>
                                        <version>[${maven.build.java.version},)</version>
                                        <message>WorkflowSim requires a JDK ${maven.build.java.version} or newer to build.</message>
                                    </requireJavaVersion>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.1</version>
                    <executions>
                        <execution>
                            <id>build-javadoc-compile-classpath</id>
                            <phase>prepare-package</phase>
                            <goals>
                                <goal>build-classpath</goal>
                            </goals>
                            <configuration>
                                <skip>${workflowsim.javadoc.skip}</skip>
                                <includeScope>compile</includeScope>
                                <outputProperty>workflowsim.javadoc.dependencyClasspath</outputProperty>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                    <executions>
                        <execution>
                            <id>prepare-unit-coverage</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>prepare-integration-coverage</id>
                            <goals>
                                <goal>prepare-agent-integration</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report-unit-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <formats>
                                    <format>HTML</format>
                                    <format>XML</format>
                                </formats>
                            </configuration>
                        </execution>
                        <execution>
                            <id>report-integration-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report-integration</goal>
                            </goals>
                            <configuration>
                                <formats>
                                    <format>HTML</format>
                                    <format>XML</format>
                                </formats>
                            </configuration>
                        </execution>
                        <execution>

                            <id>check-unit-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${workflowsim.jacoco.instruction.minimum}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${workflowsim.jacoco.branch.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                    <rule>
                                        <element>PACKAGE</element>
                                        <excludes>
                                            <exclude>org.cloudbus.*</exclude>
                                            <exclude>org.workflowsim.exception</exclude>
                                            <exclude>org.workflowsim.reclustering</exclude>
                                            <exclude>org.workflowsim.examples*</exclude>
                                            <exclude>org.workflowsim.experiments.benchmark</exclude>
                                        </excludes>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${workflowsim.jacoco.package.instruction.minimum}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${workflowsim.jacoco.package.branch.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                        <execution>

                            <id>check-integration-coverage</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <dataFile>${project.build.directory}/jacoco-it.exec</dataFile>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${workflowsim.jacoco.it.instruction.minimum}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${workflowsim.jacoco.it.branch.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <executions>
                        <execution>
                            <id>generate-maintained-api</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>javadoc</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <skip>${workflowsim.javadoc.skip}</skip>
                        <source>${maven.compiler.release}</source>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <docencoding>${project.build.sourceEncoding}</docencoding>
                        <charset>${project.build.sourceEncoding}</charset>
                        <show>protected</show>
                        <disableSourcepathUsage>true</disableSourcepathUsage>
                        <sourceFileExcludes>
                            <sourceFileExclude>**/org/cloudbus/**</sourceFileExclude>
                        </sourceFileExcludes>
                        <additionalOptions>
                            <additionalOption>-classpath</additionalOption>
                            <additionalOption>${project.build.outputDirectory}${path.separator}${workflowsim.javadoc.dependencyClasspath}</additionalOption>
                        </additionalOptions>
                        <tags>
                            <tag>
                                <name>date</name>
                                <placement>a</placement>
                                <head>Date:</head>
                            </tag>
                            <tag>
                                <name>pre</name>
                                <placement>a</placement>
                                <head>Preconditions:</head>
                            </tag>
                            <tag>
                                <name>post</name>
                                <placement>a</placement>
                                <head>Postconditions:</head>
                            </tag>
                        </tags>
                        <doclint>all,-missing</doclint>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>

                        <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                        <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}/config/checkstyle</propertyExpansion>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>

                        <violationSeverity>error</violationSeverity>
                        <failOnViolation>true</failOnViolation>
                        <logViolationsToConsole>true</logViolationsToConsole>
                        <consoleOutput>false</consoleOutput>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.0.0</version>
                    <configuration>
                        <java>
                            <!-- Palantir style: the 120-column limit matches this repository's checkstyle LineLength. -->
                            <palantirJavaFormat>
                                <version>2.50.0</version>
                            </palantirJavaFormat>
                            <!-- Import grouping matches checkstyle ImportOrder(groups/separated):
                                 blank lines between java, javax, org, com; alphabetical inside a group. -->
                            <importOrder>
                                <order>java,javax,org,com</order>
                            </importOrder>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>javadoc</id>
            <properties>
                <workflowsim.javadoc.skip>false</workflowsim.javadoc.skip>
            </properties>
        </profile>
        <profile>
            <id>core-exec</id>
            <properties>
                <workflowsim.simulator.exec.skip>false</workflowsim.simulator.exec.skip>
            </properties>
        </profile>
        <profile>
            <id>extended-corpus</id>
            <properties>

                <surefire.excludes>**/*IntegrationTest.java</surefire.excludes>
            </properties>
        </profile>
    </profiles>
</project>
