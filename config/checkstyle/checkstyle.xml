<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  WorkflowSim-yixin production-grade checkstyle configuration (code normalization program, Phase 1)

  Tier design (two tiers + ratchet):
  +=================================================================================+
  | Tier-A (severity=error) zero tolerance: the maven checkstyle:check gate fails.  |
  |   Selection criterion = semantic/correctness defect classes that are a single-  |
  |   vote veto + rules where new code is a bug by definition, and the baseline     |
  |   audit (2026-10-21 review-engineering mechanical scan, report archived with    |
  |   that temporary workspace) confirms the current backlog is 0: 100% green on    |
  |   day one.                                                                      |
  +=================================================================================+
  | Tier-B (severity=warning) advisory: all rules registered, baseline backlog in   |
  |   the audit report.                                                             |
  |   Promoted one by one via "clear in batches + upgrade to error" (promotion      |
  |   tightens the rule, never reverts).                                            |
  +=================================================================================+

  Red-line constraints (as recorded in the engineering objective):
  Red line 1: Rules may only grow, never shrink: deleting a rule or loosening a
     threshold = a contract change, requires human review; the same applies to
     suppressions.xml, where the exemption surface may only shrink.
  Red line 2: org.cloudbus.*: CloudSim upstream code takes part in formatting
     (Phase 4 formatter) but exits this checkstyle quality gate entirely (see
     BeforeExecutionExclusionFileFilter below).
  Red line 3: test-file exemptions for size/complexity/documentation are in
     suppressions.xml; semantic guard classes are not exempt.
  Red line 6: this configuration change is committed separately from any .java fix
     (in nature, "format commits and functional commits never mix").

  config_loc: injected by maven-checkstyle-plugin propertyExpansion as
  ${maven.multiModuleProjectDirectory}/config/checkstyle (Phase 2 wiring).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="[\\/]org[\\/]cloudbus[\\/]"/>
    </module>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <module name="FileTabCharacter"/>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="trailing whitespace"/>
    </module>
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="fileExtensions" value="java"/>

        <property name="severity" value="error"/>
    </module>

    <module name="TreeWalker">

        <module name="TypeName">
            <property name="severity" value="error"/>
        </module>
        <module name="PackageName">
            <property name="severity" value="error"/>
        </module>

        <module name="RedundantImport">
            <property name="severity" value="error"/>
        </module>
        <module name="UnusedImports">
            <property name="severity" value="error"/>
        </module>

        <module name="EmptyStatement">
            <property name="severity" value="error"/>
        </module>

        <module name="EqualsHashCode">
            <property name="severity" value="error"/>
        </module>

        <module name="StringLiteralEquality">
            <property name="severity" value="error"/>
        </module>

        <module name="DefaultComesLast">
            <property name="severity" value="error"/>
        </module>

        <module name="MissingSwitchDefault">
            <property name="severity" value="error"/>
        </module>

        <module name="AvoidStarImport">
            <property name="severity" value="error"/>
        </module>

        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,com"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>

            <property name="option" value="top"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
            <property name="severity" value="error"/>
        </module>

        <module name="WhitespaceAfter"/>

        <module name="WhitespaceAround">
            <property name="severity" value="error"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="LeftCurly"/>

        <module name="RightCurly">
            <property name="severity" value="error"/>
        </module>

        <module name="NeedBraces">
            <property name="severity" value="error"/>
        </module>

        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>

        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>

        <module name="MissingJavadocType">
            <property name="severity" value="info"/>
        </module>
    </module>
</module>
