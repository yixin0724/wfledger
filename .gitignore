# Build artifacts
target/
*.class
node_modules/

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
credentials.json
service-account.json
**/credentials.json
**/service-account.json
**/local.properties

# Experiment output and generated evidence (may contain host paths)
output/

# Python bytecode caches (a side effect of running the checkers locally)
scripts/__pycache__/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Large community benchmark corpora (not required by tests/experiments;
# datasets/dax fixtures needed for paper reproduction are kept)
# R9 resident-corpus guard: the five small files (33-145 KB) actually referenced by the three
# corpus gate tests are committed, so ParserCrossValidationTest / P7WfInstancesPilotMatrixTest /
# WfCommonsCliSmokeIntegrationTest no longer skip in a standard build (including a fresh CI
# checkout). A directory-level ignore cannot re-include inner files, hence the /* + ! ladder.
datasets/wfinstances/*
# The family integrity indexes ship with the repository even though the
# corpora behind them do not.
!datasets/wfinstances/INDEX.json
!datasets/wfinstances/v1.5/
datasets/wfinstances/v1.5/*
!datasets/wfinstances/v1.5/makeflow/
datasets/wfinstances/v1.5/makeflow/*
!datasets/wfinstances/v1.5/makeflow/blast/
datasets/wfinstances/v1.5/makeflow/blast/*
!datasets/wfinstances/v1.5/makeflow/blast/blast-chameleon-small-001.json
!datasets/wfinstances/v1.5/nextflow/
datasets/wfinstances/v1.5/nextflow/*
!datasets/wfinstances/v1.5/nextflow/bacass-dirt02-001.json
!datasets/wfinstances/v1.5/pegasus/
datasets/wfinstances/v1.5/pegasus/*
!datasets/wfinstances/v1.5/pegasus/srasearch/
datasets/wfinstances/v1.5/pegasus/srasearch/*
!datasets/wfinstances/v1.5/pegasus/srasearch/srasearch-chameleon-10a-001.json
!datasets/wfinstances/v1.5/pegasus/montage/
datasets/wfinstances/v1.5/pegasus/montage/*
!datasets/wfinstances/v1.5/pegasus/montage/montage-chameleon-2mass-005d-001.json
datasets/wfformat/*
!datasets/wfformat/INDEX.json
!datasets/wfformat/montage/
datasets/wfformat/montage/*
!datasets/wfformat/montage/n100/
datasets/wfformat/montage/n100/*
!datasets/wfformat/montage/n100/montage-100-000.json
datasets/wfinstances/.v1.5-git-metadata/
# The wfgen-standard n1000 instances (160 files, ~134 MB) are regenerated
# byte-identically by experiments/studies/standard-workloads/generate_corpus.py; their
# paths and sizes stay in datasets/wfgen-standard/INDEX.json. n50/n100 instances are committed.
datasets/wfgen-standard/*/n1000/

# Local manuscript workspace
paper/
